<Project Sdk="Aspire.AppHost.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Aspire injects platform-specific dashboard/orchestration packages during restore. -->
    <NuGetLockFilePath Condition="$([MSBuild]::IsOSPlatform('Windows'))">packages.windows.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="$([MSBuild]::IsOSPlatform('Linux'))">packages.linux.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="$([MSBuild]::IsOSPlatform('OSX'))">packages.macos.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\ExpensePlanner.Api\ExpensePlanner.Api.csproj" />
  </ItemGroup>
</Project>
