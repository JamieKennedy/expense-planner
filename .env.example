# Local HTTPS: use localhost. Production: use the real DNS name that points at
# this server, for example planner.example.com. Do not include https://.
APP_HOST=localhost

# Required. Replace this before the first start. Keep it stable for the lifetime
# of the PostgreSQL volume; changing it does not change an existing database user.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required. Path on the Docker host to a persistent PKCS#8 RSA private key.
# Keep the file stable and private: replacing it signs out users and invalidates
# every access token. The key itself is mounted into API/Admin as a Compose secret.
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem

# Used by the containerized SSR frontend. Keep this value unless the Compose
# service name or API port changes.
API_INTERNAL_URL=http://api:8080
